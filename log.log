PS C:\WINDOWS\system32> $ErrorActionPreference = 'Stop'
>>
>> $repo = 'Tikhon-prog/Navigator'
>> $file = 'setup_and_build.ps1'
>>
>> gh auth status --hostname github.com
>> if ($LASTEXITCODE -ne 0) {
>>     throw 'Сначала нужно войти в GitHub через gh auth login.'
>> }
>>
>> $content = gh api "repos/$repo/contents/$file" --jq '.content'
>> if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($content)) {
>>     throw 'Не удалось скачать обновлённый установщик.'
>> }
>>
>> $scriptPath = Join-Path $env:TEMP 'setup_and_build.ps1'
>> $bytes = [Convert]::FromBase64String(($content -join '').Trim())
>> [IO.File]::WriteAllBytes($scriptPath, $bytes)
>>
>> Write-Host 'Запускаю исправленную версию...' -ForegroundColor Green
>> & $scriptPath
