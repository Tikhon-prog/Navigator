# Copy values into the hosting provider's secret/environment settings.
# Do not commit live values. A production deploy must use PostgreSQL over TLS.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://navigator_app:CHANGE_ME@db.example.internal:5432/navigator?sslmode=require
NAVIGATOR_JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_VALUE_AT_LEAST_48_CHARACTERS
BOOTSTRAP_ADMIN_KEY=GENERATE_A_SEPARATE_RANDOM_VALUE_AND_REMOVE_AFTER_SETUP
# Optional: JSON service-account content from the school-owned Firebase project.
# Keep the whole value in the provider's encrypted secrets store.
FIREBASE_SERVICE_ACCOUNT_JSON=
