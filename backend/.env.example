# Поколение — серверная конфигурация.
# Скопируй в .env на сервере. Не коммить заполненный .env и ключи сервисных аккаунтов.

NAVIGATOR_SCHOOL_NAME=Школа «Поколение»
NAVIGATOR_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
NAVIGATOR_DB_PATH=/data/navigator.sqlite3
NAVIGATOR_TOKEN_TTL_SECONDS=28800
NAVIGATOR_REFRESH_TTL_SECONDS=2592000
NAVIGATOR_BOOTSTRAP_ADMIN_USERNAME=
NAVIGATOR_BOOTSTRAP_ADMIN_PASSWORD=

# Сеть. API слушает localhost через docker-compose; перед ним нужен HTTPS reverse proxy.
NAVIGATOR_ALLOWED_ORIGINS=https://school.example.ru
NAVIGATOR_NOTIFICATION_WORKER_ENABLED=true
NAVIGATOR_NOTIFICATION_POLL_SECONDS=10
NAVIGATOR_AUTO_SYNC_INTERVAL_SECONDS=300
NAVIGATOR_SCHOOL_TIMEZONE=Europe/Moscow

# SSO / OpenID Connect. Все значения должен выдать школьный IT-администратор.
NAVIGATOR_OIDC_ISSUER=
NAVIGATOR_OIDC_JWKS_URL=
NAVIGATOR_OIDC_USERINFO_URL=
NAVIGATOR_OIDC_CLIENT_ID=
NAVIGATOR_OIDC_REDIRECT_URI=ru.pokolenie.navigator:/oauthredirect
# Enable only when the IdP claims are controlled by school IT and authoritative.
NAVIGATOR_OIDC_AUTO_LINK_USERNAME=false
NAVIGATOR_OIDC_AUTO_PROVISION=false
NAVIGATOR_OIDC_ALLOW_ADMIN_PROVISION=false
NAVIGATOR_OIDC_USERNAME_CLAIM=preferred_username
NAVIGATOR_OIDC_DISPLAY_NAME_CLAIM=name
NAVIGATOR_OIDC_ROLE_CLAIM=role
NAVIGATOR_OIDC_CLASS_CLAIM=class_id

# Источник школьных данных: yandex, json или http.
NAVIGATOR_DATA_SOURCE=yandex
YANDEX_OAUTH_TOKEN=
YANDEX_FILE_PATH=app:/Navigator_Master.xlsx
NAVIGATOR_DATA_JSON_PATH=/data/school-data.json
NAVIGATOR_DATA_API_URL=
NAVIGATOR_DATA_API_TOKEN=

# Firebase Cloud Messaging: серверный service account JSON хранить вне Git и монтировать read-only.
NAVIGATOR_ENABLE_FIREBASE=true
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON_BASE64=
# Публичные клиентские параметры Android Firebase app (не service-account secret).
FIREBASE_WEB_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
