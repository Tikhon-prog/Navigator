# Keep the Docker build context small. The app source is bind-mounted at runtime.
.git
.github
.dart_tool
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache
.idea
.vscode
.gradle
.venv
venv
__pycache__
*.py[cod]
*.log
build
dist
qa
node_modules
*.gguf
*.apk
*.aab
*.exe
assets/maps/school_maps_source.pdf
assets/maps/*_source.png
assets/maps/*_debug.png

# Never pass private configuration or signing material into the Docker build context.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
secrets/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
android/key.properties
*.jks
*.keystore
service-account*.json
firebase-service-account*.json
*.p12
*.pfx
