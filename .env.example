# Copy to .env and fill values using the school's IT-approved configuration.
# Never commit .env or service-account credentials.
NAVIGATOR_TOKEN_SECRET=replace-with-at-least-32-random-characters
NAVIGATOR_DB_PATH=/data/navigator.sqlite3
NAVIGATOR_TOKEN_TTL_SECONDS=28800
NAVIGATOR_BOOTSTRAP_ADMIN_USERNAME=
NAVIGATOR_BOOTSTRAP_ADMIN_PASSWORD=

# School OIDC SSO (provided by school IT)
NAVIGATOR_OIDC_ISSUER=
NAVIGATOR_OIDC_USERINFO_URL=

# Select: yandex (default), json, or http
NAVIGATOR_DATA_SOURCE=yandex
YANDEX_OAUTH_TOKEN=
YANDEX_FILE_PATH=app:/Navigator_Master.xlsx
# For NAVIGATOR_DATA_SOURCE=json:
NAVIGATOR_DATA_JSON_PATH=/data/school-data.json
# For NAVIGATOR_DATA_SOURCE=http:
NAVIGATOR_DATA_API_URL=
NAVIGATOR_DATA_API_TOKEN=

# Firebase Admin SDK; keep credentials outside the repository and mount read-only.
NAVIGATOR_ENABLE_FIREBASE=false
FIREBASE_CREDENTIALS_PATH=
